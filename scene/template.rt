############################################################
# 🧩 miniRT Scene Template (Visual & Space-Separated)
# Replace values to build your scene
#
# ⚠️ IMPORTANT:
# • Headers use tabs for visual alignment
# • DATA LINES use SPACES ONLY (no tabs)
############################################################

############################################################
# 🎨 BACKGROUND (optional)
#
# identifier          color
#     B              <R,G,B>
#
# Example:
# B 30,35,45
############################################################

############################################################
# 🎥 CAMERA (REQUIRED — exactly one)
#
#      position               orientation         fov
# C <cam_x,cam_y,cam_z>  <dir_x,dir_y,dir_z>     <fov>
#
# Example:
# C 0,0,0 0,0,-1 60
############################################################

############################################################
# 🌫️ AMBIENT LIGHT (optional)
#
#        ratio            color
# A <ambient_ratio>      <R,G,B>
#
# Example:
# A 0.2 255,255,255
############################################################

############################################################
# 💡 MAIN LIGHT (only ONE uppercase L allowed)
#
#           position             brightness           color
# L <light_x,light_y,light_z>   <brightness>         <R,G,B>
############################################################

############################################################
# 💡 EXTRA LIGHTS (use lowercase l)
#
#           position              brightness           color
# l <light_x,light_y,light_z>    <brightness>          <R,G,B>
############################################################

############################################################
# 🎨 PATTERN (unique names required)
# Currently supported: CHECKER
#
#        name           type         color1      color2        tile
# p <pattern_name>     CHECKER     <R1,G1,B1>  <R2,G2,B2>     <tile>
#
# Example:
# p checker_floor CHECKER 255,255,255 0,0,0 10
############################################################

############################################################
# 🔴 SPHERE (multiple allowed)
#
# BASIC:
#                center           diameter   color
# sp <center_x,center_y,center_z> <diameter> <R,G,B>
#
# FULL MATERIAL CHAIN (strict order):
#                                                      ka  kd   ks   n   kr     pattern        tex_color           tex_normal
# sp <center_x,center_y,center_z> <diameter> <R,G,B>  <ka> <kd> <ks> <n> <kr> <pattern_name> <texture_color.xpm> <texture_normal.xpm>
############################################################

############################################################
# 🟦 PLANE
#
# BASIC:
#              point                 normal            color
# pl <point_x,point_y,point_z> <norm_x,norm_y,norm_z> <R,G,B>
#
# FULL:
# pl <point_x,point_y,point_z> <norm_x,norm_y,norm_z> <R,G,B>  <ka> <kd> <ks> <n> <kr> <pattern_name> <texture_color.xpm> <texture_normal.xpm>
############################################################

############################################################
# 🟩 CYLINDER
#
# BASIC:
#               center                    axis            diameter   height   color
# cy <center_x,center_y,center_z> <axis_x,axis_y,axis_z> <diameter> <height> <R,G,B>
#
# FULL:
# cy <center_x,center_y,center_z> <axis_x,axis_y,axis_z> <diameter> <height> <R,G,B>  <ka> <kd> <ks> <n> <kr> <pattern_name> <texture_color.xpm> <texture_normal.xpm>
############################################################

############################################################
# 🔺 CONE
#
# BASIC:
#             apex                  axis              angle     height   color
# cn <apex_x,apex_y,apex_z> <axis_x,axis_y,axis_z> <angle_deg> <height> <R,G,B>
#
# FULL:
# cn <apex_x,apex_y,apex_z> <axis_x,axis_y,axis_z> <angle_deg> <height> <R,G,B>  <ka> <kd> <ks> <n> <kr> <pattern_name> <texture_color.xpm> <texture_normal.xpm>
############################################################

############################################################
# ✅ QUICK RULES
############################################################
# • Exactly ONE camera
# • Only one uppercase L
# • Orientation vectors must be normalized
# • Brightness ∈ [0.0, 1.0]
# • Colors ∈ [0–255]
# • Material chain must NOT skip order
# • Pattern names must be unique
# • Missing textures/patterns → warning only
############################################################
