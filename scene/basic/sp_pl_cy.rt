############################################################

# 🧩 miniRT Example Scene (Basic — no patterns/material extras)

############################################################

############################################################

# 🎥 CAMERA (REQUIRED — exactly one)

# Field            Field                Field

# position         orientation          fov

C 0,2,8 0,0,-1 60

############################################################

# 🌫️ AMBIENT LIGHT

# Field            Field

# ratio            color

A 0.2 255,255,255

############################################################

# 💡 MAIN LIGHT

# Field            Field                Field

# position         brightness           color

L 5,10,5 0.8 255,255,255

############################################################

# 🟦 PLANE (floor)

# Field            Field                Field

# point            normal               color

pl 0,0,0 0,1,0 200,200,200

############################################################

# 🟦 PLANE (back wall)

pl 0,0,-10 0,0,1 180,180,220

############################################################

# 🔴 SPHERES

# Field            Field      Field

# center           diameter   color

sp -2,1,-4 2 255,0,0
sp 2,1,-6 2 0,0,255
sp 0,0.5,-2 1 0,255,0

############################################################

# 🟩 CYLINDERS

# Field            Field                Field      Field      Field

# center           axis                 diameter   height     color

cy -4,1,-8 0,1,0 1 3 255,255,0
cy 4,1,-5 0,1,0 1 2.5 255,100,0

############################################################

# ✅ Notes

# • No patterns

# • No material extras

# • Good for baseline lighting tests

############################################################
