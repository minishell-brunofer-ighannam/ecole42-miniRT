############################################################
# 🎨 Multi-Pattern Validation Scene
############################################################

# Background (neutral dark blue)
B 24,26,32

# Camera (wide view of all objects)
C 0,3,-14 0,0,1 70

# Ambient light
A 0.12 255,255,255

############################################################
# 💡 Lights
############################################################

# Main light (top right)
L 7,10,-6 0.9 255,255,255

# Cool fill (left)
l -8,5,-4 0.4 160,180,255

# Warm accent (front)
l 0,3,-6 0.35 255,190,140

############################################################
# 🎨 Patterns
############################################################

# Large floor checker
p checker_floor CHECKER 230,230,230 40,40,40 1

# Medium object checker
p checker_mid CHECKER 220,80,80 40,40,200 12

# Fine checker
p checker_fine CHECKER 240,240,120 60,120,60 24

# High contrast
p checker_contrast CHECKER 255,255,255 0,0,0 6

############################################################
# 🟦 Floor
############################################################

pl 0,0,0 0,1,0 200,200,200 0.15 0.75 0.25 32 0.05 checker_floor

############################################################
# 🔴 Sphere (mid checker)
############################################################

sp -4,1.2,3 2.4 200,200,200 0.10 0.70 0.60 64 0.20 checker_mid

############################################################
# 🟩 Cylinder (fine checker)
############################################################

cy 0,1.3,4 0,1,0 2.0 3.5 200,200,200 0.10 0.65 0.70 64 0.25 checker_fine

############################################################
# 🔺 Cone (high contrast checker)
############################################################

cn 4,0.01,3.5 0,1,0 22 4.2 200,200,200 0.10 0.70 0.65 64 0.20 checker_contrast
