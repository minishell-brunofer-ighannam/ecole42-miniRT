############################################################
# 🌈 Colorful Multi-Light Scene
############################################################

# Background (dark bluish)
B 25,30,45

# Camera
C 0,2,-10 0,0,1 70

# Ambient light (suave)
A 0.15 255,255,255

############################################################
# 💡 Lights
############################################################

# Main white light (top right)
L 6,8,-4 0.9 255,255,255

# Blue fill light (left)
l -6,4,-2 0.7 120,160,255

# Warm light (front low)
l 0,2,-6 0.4 255,180,120

# Magenta rim light (back)
l 0,6,6 0.35 255,120,220

############################################################
# 🟦 Floor
############################################################

pl 0,0,0 0,1,0 180,180,180

############################################################
# 🔴 Objects
############################################################

# Big center sphere (red)
sp 0,1,2 2.2 220,60,60

# Left sphere (green)
sp -3,0.8,3 1.6 80,200,120

# Right sphere (blue)
sp 3,0.8,3 1.6 80,120,220

# Back cylinder (yellow)
cy 0,1,6 0,1,0 1.2 3.5 220,200,80

# Small front cylinder (purple)
cy 1.5,0.6,1 0,1,0 0.8 1.8 180,80,220
