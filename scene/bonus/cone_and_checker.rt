############################################################
# 🎭 Cone + Checker Demo Scene
############################################################

# Background (neutral dark)
B 22,24,30

# Camera (slightly elevated, looking forward)
C 0,2.5,-10 0,0,1 70

# Ambient light (soft)
A 0.12 255,255,255

############################################################
# 💡 Lights
############################################################

# Main white light (top right)
L 6,9,-5 0.9 255,255,255

# Soft fill light (left)
l -6,4,-3 0.35 160,180,255

############################################################
# 🎨 Checker Pattern
############################################################

p floor_checker CHECKER 235,235,235 40,40,40 1

############################################################
# 🟦 Floor (checker applied)
############################################################

pl 0,0,0 0,1,0 200,200,200 0.15 0.75 0.25 32 0.1 floor_checker

############################################################
# 🔺 Main Cone (hero)
############################################################

# Cone pointing up, centered
cn 0,0.01,3 0,1,0 22 4.0 220,120,80 0.10 0.70 0.60 64 0.25

############################################################
# 🔴 Supporting Objects
############################################################

# Left sphere (glossy blue)
sp -3,1.0,2.5 2.0 90,140,220 0.12 0.65 0.55 48 0.15

# Right cylinder (metallic)
cy 3,1.0,3.5 0,1,0 1.4 4.0 100,100,110 0.05 0.50 0.85 96 0.3
